#!/usr/bin/env python3
"""Probe the bundled Vinyl Fever MCP helper over its stdio JSON-RPC interface."""

import json
import os
import subprocess
import sys
import time
from contextlib import redirect_stderr
from io import StringIO


def fail(message):
    print(f"mcp-smoke: {message}", file=sys.stderr)
    raise SystemExit(1)


def summarize(result, allow_setup_warning=False):
    chunks = [item.get("text", "") for item in result.get("content", []) if item.get("type") == "text"]
    text = " ".join(chunks).strip()
    if result.get("isError"):
        if allow_setup_warning and "set up yet" in text.lower():
            return text[:240], True
        fail(f"tool returned isError: {text or result}")
    if allow_setup_warning and "set up yet" in text.lower():
        return text[:240], True
    try:
        value = json.loads(text)
    except (TypeError, json.JSONDecodeError):
        return text[:240] or "ok", False
    if isinstance(value, dict):
        coverage = value.get("coverage", {})
        if isinstance(coverage, dict) and coverage:
            mac = coverage.get("pollingMac") or coverage.get("host") or "unknown Mac"
            age = coverage.get("lastFetchAge")
            age_text = "unknown age" if age is None else f"last fetch {age:.0f}s ago"
            return f"polling Mac: {mac}; {age_text}", False
        return ", ".join(f"{key}: {val}" for key, val in list(value.items())[:3])[:240], False
    return text[:240] or "ok", False


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
        warning, is_warning = summarize({
            "isError": True,
            "content": [{"type": "text", "text": "Listening history isn't set up yet. Run the setup-mac guide."}],
        }, allow_setup_warning=True)
        assert is_warning and "isn't set up yet" in warning
        try:
            with redirect_stderr(StringIO()):
                summarize({"isError": True, "content": [{"type": "text", "text": "The helper failed."}]}, allow_setup_warning=True)
        except SystemExit as error:
            assert error.code == 1
        else:
            raise AssertionError("an unrelated recent_listening error must fail")
        print("mcp-smoke self-test: passed")
        return
    if os.environ.get("VF_MCP_SMOKE_FAIL") == "1":
        fail("forced smoke failure requested by VF_MCP_SMOKE_FAIL")
    if len(sys.argv) != 2:
        fail("usage: python3 -I scripts/mcp-smoke <helper> | --self-test")
    helper = sys.argv[1]
    try:
        process = subprocess.Popen(
            [helper], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, bufsize=1,
        )
    except OSError as error:
        fail(f"could not start helper: {error}")

    next_id = 0

    def request(method, params=None):
        nonlocal next_id
        next_id += 1
        request_id = next_id
        message = {"jsonrpc": "2.0", "id": request_id, "method": method}
        if params is not None:
            message["params"] = params
        started = time.monotonic()
        process.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
        process.stdin.flush()
        while True:
            line = process.stdout.readline()
            if not line:
                error = process.stderr.read()
                fail(f"helper exited before {method} response: {error[-1000:]}")
            try:
                response = json.loads(line)
            except json.JSONDecodeError:
                fail(f"helper wrote non-JSON to stdout: {line[:240]!r}")
            if response.get("id") == request_id:
                elapsed = time.monotonic() - started
                if "error" in response:
                    fail(f"{method} failed: {response['error']}")
                return response.get("result", {}), elapsed

    try:
        result, elapsed = request("initialize", {
            "protocolVersion": "2025-03-26",
            "capabilities": {},
            "clientInfo": {"name": "vinyl-fever-install-smoke", "version": "1"},
        })
        print(f"initialize: {elapsed:.2f}s — {result.get('serverInfo', {}).get('name', 'server responded')}")
        process.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
        process.stdin.flush()

        result, elapsed = request("tools/list")
        tools = {tool.get("name") for tool in result.get("tools", [])}
        if "library_overview" not in tools:
            fail("tools/list did not include library_overview")
        print(f"tools/list: {elapsed:.2f}s — {len(tools)} tools; library_overview present")

        for name, arguments in (("library_overview", {}), ("recent_listening", {"period": "24h"})):
            result, elapsed = request("tools/call", {"name": name, "arguments": arguments})
            summary, warning = summarize(result, allow_setup_warning=name == "recent_listening")
            suffix = " (warning)" if warning else ""
            print(f"{name}: {elapsed:.2f}s — {summary}{suffix}")
    finally:
        process.stdin.close()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


if __name__ == "__main__":
    main()
